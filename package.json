{
  "name": "puzzle-punch-live",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:emulator": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only auth,firestore --project demo-puzzle-punch \"node --test --test-concurrency=1 'test/emulator/*.test.mjs'\"",
    "export-runs": "node scripts/export-runs.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0"
  }
}
